.p-hero{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:var(--gl-space-8);align-items:center}
.p-hero h1{font:var(--gl-type-display);color:#fff}
.p-hero .sub{color:var(--gl-brand-100);font:var(--gl-type-body-lg);margin-top:var(--gl-space-2)}
.p-hero .over{font:var(--gl-type-label);color:var(--gl-brand-200)}
.hsteps{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:var(--gl-space-2);margin-top:var(--gl-space-8);position:relative}
.hsteps div{display:flex;flex-direction:column;gap:var(--gl-space-2);font:var(--gl-type-caption);color:var(--gl-brand-200)}
.hsteps i{height:6px;border-radius:999px;background:rgb(255 255 255 / .15)}
.hsteps .done i{background:var(--gl-brand-300)}
.hsteps .cur i{background:var(--gl-accent-default)}
.hsteps .cur span{color:#fff;font-weight:600}
.count{position:relative;padding:var(--gl-space-5);border-radius:var(--gl-radius-lg);background:rgb(255 255 255 / .08);border:1px solid rgb(255 255 255 / .14);text-align:center;color:var(--gl-brand-100)}
.count b{display:block;font:700 48px/56px var(--gl-font-sans);color:#fff}
.count .ring{display:flex;justify-content:center;margin-bottom:var(--gl-space-2)}
.need{display:flex;align-items:center;gap:var(--gl-space-4);padding:var(--gl-space-4) var(--gl-space-6)}
.need + .need{border-block-start:1px solid var(--gl-border-default)}
.need .t{font:var(--gl-type-body-strong)}
.need .m{font:var(--gl-type-caption);color:var(--gl-text-muted);display:flex;gap:var(--gl-space-2);align-items:center;margin-top:2px;flex-wrap:wrap}
.need .btn{flex:none}
.pm{display:flex;align-items:center;gap:var(--gl-space-3)}
.upd{padding:var(--gl-space-4);border-radius:var(--gl-radius-md);background:var(--gl-bg-subtle);font:var(--gl-type-body-sm);display:flex;flex-direction:column;gap:var(--gl-space-2)}
.upd ul{margin:0;padding-inline-start:var(--gl-space-5);display:flex;flex-direction:column;gap:4px}
.ms{display:flex;align-items:center;gap:var(--gl-space-3);padding-block:var(--gl-space-3)}
.ms + .ms{border-block-start:1px solid var(--gl-border-default)}
.ms .dia{width:12px;height:12px;transform:rotate(45deg);border-radius:2px;flex:none;margin-inline:6px;background:var(--gl-border-strong)}
.ms.done .dia{background:var(--gl-brand-primary)}
.ms.next .dia{background:var(--gl-accent-default)}
.ms .t{font:var(--gl-type-body-sm);flex:1}
.ms .d{font:var(--gl-type-caption);color:var(--gl-text-muted)}
.count svg circle:first-child{stroke:rgb(255 255 255 / .14)}
//JS

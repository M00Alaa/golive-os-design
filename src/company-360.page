.hero{padding:var(--gl-space-6) var(--gl-space-6) 0}
  .hero-top{display:flex;align-items:flex-start;gap:var(--gl-space-5)}
  .hero-id{flex:1;min-width:0}
  .hero-id .name{display:flex;align-items:center;gap:var(--gl-space-3);flex-wrap:wrap}
  .meta{display:flex;flex-wrap:wrap;gap:var(--gl-space-2) var(--gl-space-6);margin-top:var(--gl-space-3);font:var(--gl-type-body-sm);color:var(--gl-text-secondary)}
  .meta span{display:inline-flex;align-items:center;gap:6px}
  .meta svg.i{width:16px;height:16px;color:var(--gl-text-muted)}
  .hero .tabs{margin-top:var(--gl-space-6);border-block-end:0;margin-inline:calc(var(--gl-space-6) * -1);padding-inline:var(--gl-space-6);border-block-start:1px solid var(--gl-border-default)}
  .hero .tab{height:48px}
  .plan-box{display:flex;align-items:center;gap:var(--gl-space-4);padding:var(--gl-space-4);border-radius:var(--gl-radius-md);background:var(--gl-brand-subtle);border:1px solid color-mix(in srgb,var(--gl-brand-primary) 18%,transparent)}
  .plan-box .p{font:600 18px/26px var(--gl-font-sans)}
  .plan-box .price{margin-inline-start:auto;text-align:end}
  .plan-box .price b{font:var(--gl-type-h2);direction:ltr;display:inline-block}
  .usage{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--gl-space-5) var(--gl-space-8);margin-top:var(--gl-space-6)}
  .usage .top{display:flex;justify-content:space-between;margin-bottom:var(--gl-space-2);font:var(--gl-type-label)}
  .usage .top span:last-child{color:var(--gl-text-secondary);font-variant-numeric:tabular-nums}
  .sub-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--gl-space-4);margin-top:var(--gl-space-6);padding-top:var(--gl-space-5);border-block-start:1px solid var(--gl-border-default)}
  .sub-meta .k{font:var(--gl-type-caption);color:var(--gl-text-muted)}
  .sub-meta .v{font:var(--gl-type-body-strong);margin-top:2px;display:flex;align-items:center;gap:6px}
  .kv{display:flex;justify-content:space-between;gap:var(--gl-space-4);padding-block:var(--gl-space-3);font:var(--gl-type-body-sm)}
  .kv + .kv{border-block-start:1px solid var(--gl-border-default)}
  .kv .k{color:var(--gl-text-secondary)}
  .kv .v{font-weight:500;text-align:end;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .tk{display:flex;flex-direction:column;gap:6px;padding-block:var(--gl-space-3)}
  .tk + .tk{border-block-start:1px solid var(--gl-border-default)}
  .tk .t{font:var(--gl-type-body-strong)}
  .tk .m{display:flex;align-items:center;gap:var(--gl-space-2);font:var(--gl-type-caption);color:var(--gl-text-muted)}
  .tl{position:relative;padding-inline-start:var(--gl-space-6)}
  .tl::before{content:"";position:absolute;inset-inline-start:5px;inset-block:8px;width:2px;background:var(--gl-border-default);border-radius:2px}
  .tl-i{position:relative;padding-block:0 var(--gl-space-4)}
  .tl-i:last-child{padding-bottom:0}
  .tl-i::before{content:"";position:absolute;inset-inline-start:calc(var(--gl-space-6) * -1);top:5px;width:12px;height:12px;border-radius:50%;background:var(--gl-bg-surface);border:2px solid var(--gl-brand-primary)}
  .tl-i.muted-dot::before{border-color:var(--gl-border-strong)}
  .tl-i .t{font:var(--gl-type-body-sm);color:var(--gl-text-primary)}
  .tl-i .d{font:var(--gl-type-caption);color:var(--gl-text-muted);margin-top:2px}
  .proj .nm{font:var(--gl-type-body-strong);overflow:hidden;text-overflow:ellipsis}
  .proj .cl{font:var(--gl-type-caption);color:var(--gl-text-muted);overflow:hidden;text-overflow:ellipsis}
  .ph{display:flex;flex-direction:column;gap:6px}
  .ph .r{display:flex;justify-content:space-between;font:var(--gl-type-caption);color:var(--gl-text-secondary)}
  .side{display:flex;flex-direction:column;gap:var(--gl-space-6)}
  .mainc{display:flex;flex-direction:column;gap:var(--gl-space-6)}

.toolbar .sel{width:184px}.toolbar .sel .control{width:100%}
.toolbar .search{width:320px}

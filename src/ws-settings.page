            ${row(L('ملخص يومي', 'Daily summary'), L('الساعة 8 الصبح', 'At 8:00 AM'), sw(0))}`, { tight: 1 }))}
      ${pane('int', `<div class="grid g-3">${[['odoo', 'Odoo', '#714B67', 'O', L('حالة الموديولات وترحيل البيانات', 'Module status and data push'), 0, 'odoo'], ['gcal', 'Google Calendar', '#1A73E8', 'G', L('مواعيد الورش والاجتماعات', 'Workshops and meetings'), 1], ['slack', 'Slack', '#4A154B', '#', L('تنبيهات المشاريع لقناة الفريق', 'Project alerts to a team channel'), 1], ['wa', 'WhatsApp Business', '#25D366', 'W', L('تذكيرات العملاء', 'Client reminders'), 0], ['drive', 'Google Drive', '#0F9D58', 'D', L('مزامنة ملفات المشاريع', 'Sync project files'), 0], ['ms', 'Microsoft Teams', '#5B5FC7', 'T', L('اجتماعات وتنبيهات', 'Meetings and alerts'), 0]].map(x => `<div class="card int" data-row data-int="${x[0]}"><span class="lg" style="background:${x[2]}">${x[3]}</span><div><div class="t-strong" data-f="name">${x[1]}</div><div class="t-sm sec">${x[4]}</div></div><div class="f"><span data-st>${x[5] ? ui.tag('success', L('متصل', 'Connected')) : `<button type="button" class="btn btn-outline btn-sm" ${x[6] ? `data-open="${x[6]}"` : `data-toast="success|${L('اتوصل', 'Connected')}|${x[1]}"`}>${L('توصيل', 'Connect')}</button>`}</span>${x[5] ? `<button type="button" class="btn btn-ghost btn-sm" data-confirm="disc">${L('فصل', 'Disconnect')}</button>` : ''}</div></div>`).join('')}</div>`)}
      ${pane('billing', card(L('الخطة والاستخدام', 'Plan & usage'), L('التجديد القادم 12 ديسمبر 2026', 'Renews Dec 12, 2026'), `
            <div class="planbox"><span class="kpi-icon" style="background:var(--gl-brand-primary);color:var(--gl-text-on-brand)">${icon('layers')}</span><div class="grow"><div class="p">Growth</div><div class="t-sm sec">${L('$179 شهريًا · Visa •••• 4242', '$179 / month · Visa •••• 4242')}</div></div><a class="btn btn-primary btn-sm" href="onboarding-plan.html">${L('ترقية لـ Enterprise', 'Upgrade to Enterprise')}</a></div>
            <div class="usage">${usage(L('المستخدمين', 'Users'), 10, 30)}${usage(L('المشاريع النشطة', 'Active projects'), 7, 10, '', 'warn')}${usage(L('التخزين', 'Storage'), 3.2, 10, ' GB')}</div>`) +
        `<div class="card sec-card table-wrap"><div class="card-head"><div><h3 class="t-h3">${L('الفواتير', 'Invoices')}</h3><p class="sub">${L('بتتبعت لـ billing@nilesoft.example', 'Sent to billing@nilesoft.example')}</p></div><button type="button" class="btn btn-outline btn-sm" data-toast="info|${L('تحديث الكارت', 'Update card')}|Visa •••• 4242">${icon('credit-card', 'sm')}${L('تغيير الكارت', 'Change card')}</button></div>

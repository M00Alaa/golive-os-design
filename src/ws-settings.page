.sec-card .card-head{border-block-end:1px solid var(--gl-border-default)}
.logo-up{display:flex;align-items:center;gap:var(--gl-space-4)}
.logo-up .avatar{width:64px;height:64px;font-size:24px;border-radius:var(--gl-radius-lg)}
.prefix{display:flex;align-items:stretch;height:40px;border:1px solid var(--gl-border-default);border-radius:var(--gl-radius-md);overflow:hidden;background:var(--gl-bg-surface);box-shadow:var(--gl-shadow-xs);direction:ltr}
.prefix span{display:flex;align-items:center;padding-inline:var(--gl-space-3);background:var(--gl-bg-subtle);color:var(--gl-text-muted);font:var(--gl-type-body-sm);border-inline-end:1px solid var(--gl-border-default)}
.prefix input{flex:1;min-width:0;border:0;outline:0;padding-inline:var(--gl-space-3);background:transparent;font:var(--gl-type-body)}
.prefix span.suf{border-inline-end:0;border-inline-start:1px solid var(--gl-border-default)}
.pv{border:1px solid var(--gl-border-default);border-radius:var(--gl-radius-md);overflow:hidden;background:var(--gl-bg-canvas)}
.pv-bar{display:flex;align-items:center;gap:var(--gl-space-2);padding:var(--gl-space-3);background:var(--gl-bg-surface);border-block-end:1px solid var(--gl-border-default);font:var(--gl-type-label-sm)}
.pv-hero{margin:var(--gl-space-3);padding:var(--gl-space-4);border-radius:var(--gl-radius-md);background:linear-gradient(135deg,#7C2D12,#C2410C);color:#fff;font:var(--gl-type-label)}
.pv-hero .bar{background:rgb(255 255 255 / .2);margin-top:var(--gl-space-3)}
.pv-hero .bar > i{background:#FDBA74}
.pv-rows{padding:0 var(--gl-space-3) var(--gl-space-3);display:flex;flex-direction:column;gap:6px}
.pv-rows i{display:block;height:10px;border-radius:4px;background:var(--gl-bg-subtle)}
.planbox{display:flex;align-items:center;gap:var(--gl-space-4);padding:var(--gl-space-4);border-radius:var(--gl-radius-md);background:var(--gl-brand-subtle);border:1px solid color-mix(in srgb,var(--gl-brand-primary) 18%,transparent)}
.planbox .p{font:600 18px/26px var(--gl-font-sans)}
.usage{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--gl-space-5);margin-top:var(--gl-space-5)}
.usage .top{display:flex;justify-content:space-between;margin-bottom:var(--gl-space-2);font:var(--gl-type-label)}
.usage .top span:last-child{color:var(--gl-text-secondary);font-variant-numeric:tabular-nums}
.int{display:flex;flex-direction:column;gap:var(--gl-space-3);padding:var(--gl-space-5)}
.int .lg{width:40px;height:40px;border-radius:var(--gl-radius-md);display:grid;place-items:center;font:700 15px/1 var(--gl-font-sans);color:#fff}
.int .f{display:flex;align-items:center;justify-content:space-between;margin-top:auto}
.stt{display:flex;align-items:center;gap:var(--gl-space-3);padding:var(--gl-space-2) var(--gl-space-3);border:1px solid var(--gl-border-default);border-radius:var(--gl-radius-md);background:var(--gl-bg-surface)}
.stt .grip{color:var(--gl-text-muted);cursor:grab}
.set-row .ctl .control{width:100%}
//JS
GL.mount({
  shell: 'ws', nav: 'ws-settings',
  title: L => L('إعدادات المساحة', 'Workspace settings'),
  modals: {
    odoo: { icon: 'plug', title: L => L('ربط Odoo', 'Connect Odoo'), sub: L => L('عشان نسحب حالة الموديولات ونرحّل البيانات مباشرة', 'To read module status and push migrated data'),
      body: (L, { ui }) => `${ui.field(L('رابط Odoo', 'Odoo URL'), ui.input('url', { req: 1, ltr: 1, icon: 'link', ph: 'https://erp.client.example' }), { req: 1 })}<div class="form-grid">${ui.field(L('قاعدة البيانات', 'Database'), ui.input('db', { req: 1, ltr: 1 }), { req: 1 })}${ui.field(L('الإصدار', 'Version'), ui.select('v', ['17.0', '18.0', '19.0'], { val: '18.0' }))}${ui.field(L('اسم المستخدم', 'Username'), ui.input('u', { req: 1, ltr: 1 }), { req: 1 })}${ui.field(L('مفتاح API', 'API key'), ui.input('k', { req: 1, ltr: 1, type: 'password' }), { req: 1 })}</div>`,
      submit: L => L('اختبار وربط', 'Test & connect'), onSubmit: () => { const r = document.querySelector('[data-int=odoo] [data-st]'); if (r) r.innerHTML = GL.ui.tag('success', GL.L('متصل', 'Connected')); }, toast: L => [L('اتربط Odoo', 'Odoo connected'), L('الاتصال نجح في 240ms', 'Connection succeeded in 240ms')] },
    cancel: { icon: 'circle-x', tone: 'danger', danger: 1, title: L => L('إلغاء الاشتراك', 'Cancel subscription'), sub: L => L('هيفضل شغال لحد 12 ديسمبر', 'Stays active until Dec 12'),
      body: (L, { ui }) => `<div class="callout warning">${GL.icon('alert-triangle', 'sm')}<span>${L('بعد نهاية الفترة، المساحة هتتحول للقراءة فقط وبوابات العملاء هتتقفل.', 'After the period ends, the workspace becomes read-only and client portals close.')}</span></div>${ui.field(L('ليه بتلغي؟', 'Why are you cancelling?'), ui.select('r', [L('السعر', 'Price'), L('ناقص مزايا', 'Missing features'), L('هنستخدم أداة تانية', 'Switching tools'), L('المشاريع خلصت', 'Projects finished')], { ph: L('اختار سبب', 'Choose a reason'), req: 1 }), { req: 1 })}${ui.field(L('حاجة نقدر نحسنها؟', 'Anything we could improve?'), ui.textarea('f', { rows: 3 }), { opt: L('اختياري', 'optional') })}`,
      submit: L => L('تأكيد الإلغاء', 'Confirm cancellation'), toast: L => [L('الاشتراك هيتلغى 12 ديسمبر', 'Subscription cancels Dec 12'), L('تقدر ترجع في أي وقت', 'You can resume any time'), 'warning'] },
    status: { size: 'sm', icon: 'plus', title: L => L('حالة جديدة', 'New status'), body: (L, { ui }) => `${ui.field(L('الاسم', 'Name'), ui.input('name', { req: 1 }), { req: 1 })}${ui.field(L('اللون', 'Colour'), ui.select('c', [['success', L('أخضر', 'Green')], ['warning', L('أصفر', 'Amber')], ['danger', L('أحمر', 'Red')], ['info', L('أزرق', 'Blue')]]))}`,
      submit: L => L('إضافة', 'Add'), add: { table: 'sttList', prepend: false, row: (v, L) => `<div class="stt" data-row>${GL.icon('grip-vertical', 'sm grip')}${GL.ui.tag(v.c, v.name)}<span class="grow"></span><button type="button" class="icon-btn sm" data-delete="${v.name}">${GL.icon('trash-2')}</button></div>` }, toast: L => [L('اتضافت الحالة', 'Status added'), ''] }
  },
  confirms: {
    del: { danger: 1, icon: 'trash-2', title: L => L('حذف مساحة نيل سوفت نهائيًا؟', 'Delete the NileSoft workspace?'), text: L => L('7 مشاريع و8 بوابات عملاء وكل الملفات هتتمسح بعد 30 يوم.', '7 projects, 8 client portals and all files are erased after 30 days.'), type: () => 'nilesoft', btn: L => L('حذف المساحة', 'Delete workspace'), toast: L => [L('المساحة هتتحذف بعد 30 يوم', 'Workspace scheduled for deletion'), L('تقدر تلغي الحذف من الإيميل', 'Cancel from the email we sent'), 'warning'] },
    disc: { danger: 1, icon: 'plug', title: (L, c) => L(`فصل ${c.name}؟`, `Disconnect ${c.name}?`), btn: L => L('فصل', 'Disconnect'), run: (L, c, row) => { row.querySelector('[data-st]').innerHTML = `<button type="button" class="btn btn-outline btn-sm" data-toast="success|${L('اتوصل', 'Connected')}|">${L('توصيل', 'Connect')}</button>`; row.querySelector('[data-confirm]').remove(); }, toast: (L, c) => [L('اتفصل', 'Disconnected'), c.name] }
  },
  render: (L, { icon, ui }) => {
    const sub = [['general', 'settings', L('عام', 'General')], ['brand', 'palette', L('الهوية وبوابة العميل', 'Branding & portal')], ['defaults', 'layout-template', L('افتراضيات المشاريع', 'Project defaults')], ['notif', 'bell', L('الإشعارات', 'Notifications')], ['int', 'plug', L('التكاملات', 'Integrations')], ['billing', 'credit-card', L('الخطة والفوترة', 'Plan & billing')]];
    const row = (t, d, ctl) => `<div class="set-row"><div><div class="t">${t}</div><div class="d">${d}</div></div><div class="ctl">${ctl}</div></div>`;
    const sw = (on, lbl) => `<span class="switch ${on ? 'on' : ''}" data-label="${lbl || ''}"></span>`;
    const usage = (l, u, t, unit, cls) => `<div><div class="top"><span>${l}</span><span class="ltr">${u}${unit || ''} / ${t}${unit || ''}</span></div><div class="bar thin ${cls || ''}"><i style="width:${u / t * 100}%"></i></div></div>`;
    const card = (t, d, body, o) => { o = o || {}; return `<div class="card sec-card" ${o.form ? 'data-form' : ''}><div class="card-head"><div><h3 class="t-h3">${t}</h3><p class="sub">${d}</p></div>${o.act || ''}</div><div class="card-body ${o.cls || ''}" ${o.tight ? 'style="padding-block:var(--gl-space-2)"' : ''}>${body}</div>${o.form ? `<div class="sticky-save"><button type="button" class="btn btn-ghost" data-toast="info|${L('اترجعت التغييرات', 'Changes discarded')}|">${L('إلغاء', 'Cancel')}</button><button type="button" class="btn btn-primary" data-save>${L('حفظ', 'Save')}</button></div>` : ''}</div>`; };
    const pane = (k, html) => `<div class="stack gap-6" data-pane-group="wset" data-pane="${k}" ${k === 'general' ? '' : 'hidden'}>${html}</div>`;
    return `
    <div class="page-head"><div><h1 class="t-h1">${L('إعدادات المساحة', 'Workspace settings')}</h1><p class="sub">${L('نيل سوفت للحلول · بتتطبق على كل المشاريع والأعضاء', 'NileSoft Solutions · applies to every project and member')}</p></div></div>
    <section class="settings">
      <nav class="subnav" data-tabs="wset" data-act="on">${sub.map((s, i) => `<a class="${i ? '' : 'on'}" href="#" data-tab="${s[0]}">${icon(s[1])}<span>${s[2]}</span></a>`).join('')}<a href="#" data-tab="danger" style="color:var(--gl-danger-fg)">${icon('alert-triangle')}<span>${L('منطقة الخطر', 'Danger zone')}</span></a></nav>
      <div>
      ${pane('general', card(L('بيانات الشركة', 'Company profile'), L('بتظهر لعملائك في البوابة والإيميلات', 'Shown to your clients in the portal and emails'), `
            <div class="logo-up"><span class="avatar ws-logo">${L('ن', 'NS')}</span><div><div class="t-strong">${L('شعار الشركة', 'Company logo')}</div><div class="t-cap muted">${L('PNG أو SVG · مربع · 512px على الأقل', 'PNG or SVG · square · at least 512px')}</div><div class="row gap-2 mt-2"><button type="button" class="btn btn-outline btn-sm" data-toast="success|${L('اترفع الشعار', 'Logo uploaded')}|logo.svg">${icon('upload')}${L('رفع شعار', 'Upload')}</button><button type="button" class="btn btn-ghost btn-sm" data-toast="info|${L('اتشال الشعار', 'Logo removed')}|">${L('إزالة', 'Remove')}</button></div></div></div>
            <div class="form-grid">
              ${ui.field(L('اسم الشركة', 'Company name'), ui.input('n', { req: 1, val: L('نيل سوفت للحلول', 'NileSoft Solutions') }), { req: 1 })}
              <div class="field"><label>${L('رابط المساحة', 'Workspace URL')}</label><div class="prefix"><input name="slug" value="nilesoft" data-req><span class="suf">.golive.example</span></div></div>
              ${ui.field(L('لغة المساحة', 'Workspace language'), ui.select('lang', [L('العربية + English', 'Arabic + English'), L('العربية فقط', 'Arabic only'), 'English only'], { icon: 'languages' }))}
              ${ui.field(L('المنطقة الزمنية', 'Time zone'), ui.select('tz', [L('القاهرة (UTC+2)', 'Cairo (UTC+2)'), L('الرياض (UTC+3)', 'Riyadh (UTC+3)')], { icon: 'clock' }))}
              ${ui.field(L('أيام العمل', 'Working days'), ui.select('wd', [L('الأحد – الخميس', 'Sun – Thu'), L('الإثنين – الجمعة', 'Mon – Fri'), L('السبت – الخميس', 'Sat – Thu')], { icon: 'calendar' }))}
              ${ui.field(L('العملة الافتراضية للعقود', 'Default contract currency'), ui.select('cur', ['EGP — ج.م', 'USD — $', 'SAR — ر.س'], { icon: 'banknote' }))}
            </div>`, { form: 1, cls: 'stack gap-6' }))}
      ${pane('brand', card(L('هوية بوابة العميل', 'Client portal branding'), L('عميلك يشوف شعارك وألوانك، مش GoLive', 'Clients see your logo and colours, not GoLive'), `
            <div class="stack gap-5">
              <div class="field"><label>${L('اللون الأساسي', 'Primary colour')}</label><div class="swatch-pick" data-pick><i style="background:#0A8F78"></i><i class="on" style="background:#C2410C"></i><i style="background:#2563EB"></i><i style="background:#7C3AED"></i><i style="background:#0F172A"></i></div></div>
              ${ui.field(L('دومين مخصص', 'Custom domain'), ui.input('dom', { ltr: 1, val: 'portal.nilesoft.example', icon: 'globe' }), { hint: `<span class="row gap-1" style="color:var(--gl-success-fg)">${icon('check-circle', 'xs')}${L('الـ DNS متظبط · شهادة SSL فعالة', 'DNS verified · SSL active')}</span>` })}
              ${ui.field(L('رسالة الترحيب في البوابة', 'Portal welcome message'), ui.textarea('wm', { rows: 3, val: L('أهلًا بيك في بوابة مشروعك مع نيل سوفت. هنا هتلاقي كل اللي محتاجه.', 'Welcome to your project portal with NileSoft. Everything you need is here.') }))}
              ${row(L('إظهار «مدعوم من GoLive»', 'Show “Powered by GoLive”'), L('في أسفل البوابة', 'In the portal footer'), sw(0))}
            </div>
            <div><div class="t-label sec" style="margin-bottom:var(--gl-space-2)">${L('معاينة', 'Preview')}</div><div class="pv"><div class="pv-bar"><span class="avatar ws-logo" style="width:22px;height:22px;font-size:10px;border-radius:6px">${L('ن', 'NS')}</span>${L('نيل سوفت · بوابة العميل', 'NileSoft · Client portal')}</div><div class="pv-hero">${L('تطبيق Odoo ERP · 72%', 'Odoo ERP rollout · 72%')}<div class="bar thin"><i style="width:72%"></i></div></div><div class="pv-rows"><i style="width:80%"></i><i style="width:60%"></i><i style="width:70%"></i></div></div><a class="btn btn-outline btn-sm mt-3" href="portal.html">${icon('external-link', 'sm')}${L('افتح البوابة', 'Open portal')}</a></div>`, { form: 1, cls: 'grid g-2', act: ui.tag('brand', 'Growth', false) }))}
      ${pane('defaults', card(L('افتراضيات المشاريع الجديدة', 'New project defaults'), L('بتتطبق وقت إنشاء أي مشروع', 'Applied when a project is created'), `<div class="form-grid">
            ${ui.field(L('القالب الافتراضي', 'Default playbook'), ui.select('tp', [L('Odoo ERP قياسي', 'Odoo ERP standard'), 'Odoo CRM', L('من غير قالب', 'Blank')], { icon: 'layout-template' }))}
            ${ui.field(L('بادئة أرقام المتطلبات', 'Requirement ID prefix'), ui.input('pre', { req: 1, ltr: 1, val: 'REQ-' }), { req: 1 })}
            ${ui.field(L('تذكير الموافقات بعد', 'Remind approvers after'), ui.select('rem', [L('يوم', '1 day'), L('يومين', '2 days'), L('3 أيام', '3 days')], { val: L('يومين', '2 days'), icon: 'bell' }))}
            ${ui.field(L('مدة الدعم بعد الإطلاق', 'Hypercare length'), ui.select('hc', [L('14 يوم', '14 days'), L('30 يوم', '30 days'), L('60 يوم', '60 days')], { val: L('30 يوم', '30 days'), icon: 'life-buoy' }))}</div>
            ${row(L('تفعيل بوابة العميل تلقائيًا', 'Enable client portal automatically'), L('للمشاريع الجديدة', 'For new projects'), sw(1))}
            ${row(L('العميل يقدر يضيف متطلبات', 'Clients can submit requirements'), L('من البوابة، وبتوصل كمسودة للمراجعة', 'From the portal, arriving as drafts for review'), sw(1))}`, { form: 1 }) +
        card(L('حالات المتطلبات', 'Requirement statuses'), L('اسحب لترتيبها · بتظهر للعميل بنفس الأسماء', 'Drag to reorder · clients see the same names'), `<div class="stack gap-2" id="sttList">${[['neutral', L('مسودة', 'Draft')], ['warning', L('مستني العميل', 'Waiting on client')], ['info', L('قيد التنفيذ', 'In progress')], ['danger', 'Blocker'], ['success', L('معتمد', 'Approved')]].map(t => `<div class="stt" data-row>${icon('grip-vertical', 'sm grip')}${ui.tag(t[0], t[1])}<span class="grow"></span><button type="button" class="icon-btn sm" data-delete="${t[1]}">${icon('trash-2')}</button></div>`).join('')}</div>`, { act: `<button type="button" class="btn btn-outline btn-sm" data-open="status">${icon('plus')}${L('حالة', 'Status')}</button>` }))}
      ${pane('notif', card(L('الإشعارات للعملاء', 'Client notifications'), L('إيه اللي يتبعت لجهات اتصال العميل تلقائيًا', 'What client contacts receive automatically'), `
            ${row(L('تحديث أسبوعي بالتقدم', 'Weekly progress digest'), L('كل يوم أحد 9 الصبح بتوقيت القاهرة', 'Every Sunday 9:00 AM Cairo time'), sw(1, L('التحديث الأسبوعي', 'Weekly digest')))}
            ${row(L('تذكير بالموافقات المتأخرة', 'Overdue sign-off reminders'), L('بعد يومين، وبعدها كل 3 أيام', 'After 2 days, then every 3 days'), sw(1))}
            ${row(L('إشعار عند إغلاق مرحلة', 'Phase completed notice'), L('مع ملخص اللي اتعمل والخطوة الجاية', 'With a summary and next step'), sw(1))}
            ${row(L('رسائل واتساب', 'WhatsApp messages'), L('محتاج ربط WhatsApp Business', 'Requires WhatsApp Business connection'), `<button type="button" class="btn btn-outline btn-sm" data-goto="wset:int">${icon('plug')}${L('ربط', 'Connect')}</button>`)}`, { tight: 1 }) +
        card(L('إشعارات الفريق', 'Team notifications'), L('لأعضاء نيل سوفت', 'For NileSoft members'), `
            ${row(L('العميل رفع ملف أو رد', 'Client uploaded or replied'), L('لمدير المشروع', 'To the project manager'), sw(1))}

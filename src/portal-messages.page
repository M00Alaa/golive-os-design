.ml{display:flex;flex-direction:column}
.mi{display:flex;gap:var(--gl-space-3);padding:var(--gl-space-4) var(--gl-space-5);border-inline-start:3px solid transparent}
.mi + .mi{border-block-start:1px solid var(--gl-border-default)}
.mi.on{background:var(--gl-brand-subtle);border-inline-start-color:var(--gl-brand-primary)}
.mi .t{font:var(--gl-type-body-strong);display:flex;justify-content:space-between;gap:var(--gl-space-2)}
.mi .t small{font:var(--gl-type-caption);color:var(--gl-text-muted);flex:none}
.mi .p{font:var(--gl-type-body-sm);color:var(--gl-text-secondary);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:2px}
.mi .dot-u{width:8px;height:8px;border-radius:50%;background:var(--gl-accent-default);flex:none;margin-top:8px}
.post{padding:var(--gl-space-6);display:flex;flex-direction:column;gap:var(--gl-space-5)}
.post-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--gl-space-3)}
.post-kpis div{padding:var(--gl-space-4);border-radius:var(--gl-radius-md);background:var(--gl-bg-subtle)}
.post-kpis b{display:block;font:600 22px/30px var(--gl-font-sans)}
.post-kpis span{font:var(--gl-type-caption);color:var(--gl-text-secondary)}
.post h4{font:var(--gl-type-label);display:flex;align-items:center;gap:var(--gl-space-2);margin-bottom:var(--gl-space-2)}
.post ul{margin:0;padding-inline-start:var(--gl-space-6);display:flex;flex-direction:column;gap:6px;font:var(--gl-type-body)}
.reacts{display:flex;gap:var(--gl-space-2)}
.reacts span{display:inline-flex;align-items:center;gap:4px;height:28px;padding-inline:var(--gl-space-2);border-radius:999px;border:1px solid var(--gl-border-default);font:var(--gl-type-label-sm)}
//JS
GL.mount({
  shell: 'portal', nav: 'p-msg',
  title: L => L('الرسائل والتحديثات', 'Messages & updates'),
  render: (L, { icon, ui }) => {
    const M = [
      ['megaphone', 'brand', L('التحديث الأسبوعي #12', 'Weekly update #12'), L('الأحد', 'Sun'), L('خلصنا ترحيل الأصناف وبدأنا UAT دورة 2. محتاجين منك 4 حاجات…', 'Finished product migration and started UAT cycle 2. We need 4 things from you…'), 1, 1],
      ['message', '', L('ميزان البوابة', 'Weighbridge integration'), L('أمس', 'Yesterday'), L('ياسمين: المورد وعد يبعت الـ API docs يوم الأربع.', 'Yasmin: the vendor promised the API docs by Wednesday.'), 1],
      ['message', '', L('تدريب المستخدمين', 'End-user training'), L('20 نوف', 'Nov 20'), L('منى: اقترحنا 3 مواعيد، اختار اللي يناسبكم.', 'Mona: we proposed 3 slots, pick what suits you.')],
      ['megaphone', 'brand', L('التحديث الأسبوعي #11', 'Weekly update #11'), L('15 نوف', 'Nov 15'), L('اكتملت مرحلة ترحيل البيانات بنجاح ✔', 'Data migration phase completed ✔')],
      ['flag', 'success', L('اكتملت مرحلة: ترحيل البيانات', 'Phase completed: Data migration'), L('18 نوف', 'Nov 18'), L('ملخص المرحلة وأرقام الترحيل النهائية', 'Phase summary and final migration numbers')]
    ];
    return `
    <div class="page-head">
      <div><h1 class="t-h1">${L('الرسائل والتحديثات', 'Messages & updates')}</h1><p class="sub">${L('تحديثات أسبوعية من الفريق ومحادثات حسب الموضوع — بدل الواتساب والإيميلات المتفرقة', 'Weekly updates and topic threads — instead of scattered WhatsApp and email')}</p></div>
      <div class="actions"><button class="btn btn-primary">${icon('plus', 'sm')}${L('رسالة جديدة', 'New message')}</button></div>
    </div>
    <section class="grid g-12" style="align-items:start">
      <aside class="span-4 card ml">
        <div class="toolbar" style="padding:var(--gl-space-3) var(--gl-space-4)"><label class="control search grow" style="width:auto">${icon('search', 'sm')}<input placeholder="${L('ابحث…', 'Search…')}"></label></div>
        ${M.map(m => `<div class="mi ${m[6] ? 'on' : ''}"><span class="ic-tile" style="width:36px;height:36px;${m[1] === 'success' ? ui.tone.success : m[1] ? '' : 'background:var(--gl-bg-subtle);color:var(--gl-text-secondary)'}">${icon(m[0], 'sm')}</span><div class="grow" style="min-width:0"><div class="t"><span class="ell">${m[2]}</span><small>${m[3]}</small></div><div class="p">${m[4]}</div></div>${m[5] && !m[6] ? '<span class="dot-u"></span>' : ''}</div>`).join('')}
      </aside>
      <div class="span-8 stack gap-6">
        <article class="card post">
          <div class="row gap-3">${ui.av(L('م', 'MA'), 'av-teal', 'round')}<div class="grow"><div class="t-strong">${L('منى عادل', 'Mona Adel')} <span class="t-cap muted">· ${L('مديرة المشروع', 'Project manager')}</span></div><div class="t-cap muted">${L('الأحد 22 نوفمبر · 9:00 ص', 'Sunday, Nov 22 · 9:00 AM')}</div></div>${ui.tag('success', L('في المسار', 'On track'))}</div>
          <div><h2 class="t-h2">${L('التحديث الأسبوعي #12 — بدأنا UAT دورة 2', 'Weekly update #12 — UAT cycle 2 is underway')}</h2></div>
          <div class="post-kpis"><div><b>72%</b><span>${L('التقدم الكلي (<span class="ltr">+6%</span>)', 'Overall progress (+6%)')}</span></div><div><b>14 / 23</b><span>${L('مهام UAT خلصت', 'UAT tasks done')}</span></div><div><b>21</b><span>${L('يوم على الإطلاق', 'days to go-live')}</span></div></div>
          <div><h4 class="yes">${icon('check-circle', 'sm')}${L('خلصنا الأسبوع ده', 'Done this week')}</h4><ul><li>${L('ترحيل كل بيانات الأصناف (4,812 صنف) بدون أخطاء', 'Migrated all 4,812 product records with zero errors')}</li><li>${L('UAT دورة 1 مع المبيعات والمخازن — 31 سيناريو نجحوا من 34', 'UAT cycle 1 with Sales & Inventory — 31 of 34 scenarios passed')}</li></ul></div>
          <div><h4 style="color:var(--gl-accent-text)">${icon('hand-helping', 'sm')}${L('محتاجين منك', 'Needed from you')}</h4><ul><li>${L('نموذج صلاحيات المستخدمين — قبل الأربع', 'User permissions form — by Wednesday')}</li><li>${L('توقيع سيناريوهات UAT v3 — قبل الخميس', 'Sign UAT scenarios v3 — by Thursday')}</li></ul></div>
          <div class="callout warning">${icon('alert-triangle', 'sm')}<span>${L('Blocker: مورّد الميزان لسه مبعتش الـ API docs. لو اتأخر بعد الأربع، هنأجل ربط الميزان لبعد الإطلاق من غير ما يأثر على الموعد.', 'Blocker: the weighbridge vendor hasn’t sent API docs. If it slips past Wednesday we’ll move that link to after go-live without affecting the date.')}</span></div>
          <div class="row between"><div class="reacts"><span>👍 3</span><span>🎉 1</span><span>${icon('smile', 'xs')}</span></div><span class="t-cap muted">${L('شافه خالد، هبة وطارق', 'Seen by Khaled, Heba and Tarek')}</span></div>
        </article>
        <div class="card"><div class="card-body thread">
          <div class="msg mine">${ui.av(L('خ', 'KM'), 'av-amber', 'round')}<div class="bubble"><div class="hd"><b>${L('خالد منصور', 'Khaled Mansour')}</b><span>· 10:14 AM</span></div><div class="bd">${L('تمام يا منى، هبعت النموذج النهارده بالليل. بالنسبة للميزان، موافق على التأجيل لو احتجنا.', 'Thanks Mona — I’ll send the form tonight. On the weighbridge, I’m fine with deferring if needed.')}</div></div></div>
          <div class="msg">${ui.av(L('م', 'MA'), 'av-teal', 'round')}<div class="bubble"><div class="hd"><b>${L('منى عادل', 'Mona Adel')}</b><span>· 10:31 AM</span></div><div class="bd">${L('ممتاز، هسجّل قرار التأجيل كموافقة صغيرة عشان يبقى موثق 👌', 'Great — I’ll log the deferral as a small sign-off so it’s documented 👌')}</div></div></div>
          <div class="composer"><div class="ta">${L('اكتب رد…', 'Write a reply…')}</div><div class="bar2"><button class="icon-btn sm">${icon('paperclip')}</button><button class="icon-btn sm">${icon('smile')}</button><div class="end"><button class="btn btn-primary btn-sm">${icon('send', 'sm flip')}${L('إرسال', 'Send')}</button></div></div></div>
        </div></div>
      </div>
    </section>`;
  }
});

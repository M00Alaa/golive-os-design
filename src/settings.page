      submit: L => L('إنشاء المفتاح', 'Create key'), add: { table: 'keyList', row: (v, L) => keyRow(L, [v.name, 'gl_live_••••••••••••••••' + Math.random().toString(16).slice(2, 6), L('لسه متستخدمش', 'Never used')]) },
      toast: L => [L('اتعمل المفتاح واتنسخ', 'Key created and copied'), L('احفظه في مكان آمن', 'Store it somewhere safe')] },

.sec-card .card-head{border-block-end:1px solid var(--gl-border-default)}
.danger-card{border-color:color-mix(in srgb,var(--gl-danger-solid) 35%,var(--gl-border-default))}
.key{display:flex;align-items:center;gap:var(--gl-space-3);padding:var(--gl-space-3) var(--gl-space-4);border:1px solid var(--gl-border-default);border-radius:var(--gl-radius-md);background:var(--gl-bg-subtle)}
.key code{font:500 13px/20px ui-monospace,Menlo,Consolas,monospace;direction:ltr;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:start}
.int{display:flex;flex-direction:column;gap:var(--gl-space-3);padding:var(--gl-space-5)}
.int .lg{width:40px;height:40px;border-radius:var(--gl-radius-md);display:grid;place-items:center;font:700 15px/1 var(--gl-font-sans);color:#fff}
.int .f{display:flex;align-items:center;justify-content:space-between;margin-top:auto}
.dns td{font:500 12px/18px ui-monospace,Menlo,Consolas,monospace}
.tpl{display:flex;align-items:center;gap:var(--gl-space-4);padding:var(--gl-space-4) var(--gl-space-6)}
.tpl + .tpl{border-block-start:1px solid var(--gl-border-default)}
//JS
const keyRow = (L, k) => `<div class="key" data-row>${GL.icon('key-round', 'sm')}<div class="grow" style="min-width:0"><div class="t-strong t-sm" data-f="name">${k[0]}</div><code>${k[1]}</code></div><span class="t-cap muted">${k[2]}</span><button type="button" class="icon-btn sm" data-toast="success|${L('اتنسخ', 'Copied')}|">${GL.icon('copy')}</button><button type="button" class="icon-btn sm" data-confirm="revoke" title="Revoke">${GL.icon('trash-2')}</button></div>`;

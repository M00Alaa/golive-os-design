        ${ui.field(L('النص', 'Body'), ui.textarea('body', { rows: 8, val: L('أهلًا {{owner.first_name}}،\n\nفترة GoLive OS التجريبية لـ {{company.name}} هتخلص يوم {{trial.ends_at}}. اختار خطة عشان مشاريعك وبوابات عملائك تفضل شغالة.\n\n{{button: اختار خطة}}', 'Hi {{owner.first_name}},\n\nThe GoLive OS trial for {{company.name}} ends on {{trial.ends_at}}. Pick a plan to keep your projects and client portals running.\n\n{{button: Choose a plan}}') }), { hint: L('المتغيرات المتاحة: {{owner.first_name}} {{company.name}} {{trial.ends_at}}', 'Variables: {{owner.first_name}} {{company.name}} {{trial.ends_at}}') })}`,

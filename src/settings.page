        <div class="field"><label>${L('الأحداث', 'Events')}</label><div class="row gap-2 wrap" data-multi data-req-group>${['company.created', 'invoice.paid', 'invoice.failed', 'subscription.cancelled', 'ticket.created'].map((e, i) => `<span class="opt ${i < 2 ? 'on' : ''}" style="padding:6px 12px"><span class="box ${i < 2 ? 'on' : ''}">${i < 2 ? GL.icon('check') : ''}</span><span class="ltr t-sm">${e}</span></span>`).join('')}</div></div>`,

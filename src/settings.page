      add: { table: 'hookTbl', row: (v, L) => hookRow(L, [v.url, v.ev || [], 1]) }, toast: L => [L('اتضاف الـ Webhook', 'Webhook added'), L('بعتنا حدث تجريبي', 'We sent a test event')] },
    tpl: { kind: 'drawer', size: 'lg', icon: 'mail', title: (L, c) => c.name, sub: L => L('قالب البريد · عربي وإنجليزي', 'Email template · Arabic & English'),

const riskRow = (L, r) => `<tr data-row data-cat="${r[0]}"><td><span class="sev-dot" style="background:var(--gl-${r[1]}-solid)"></span></td><td><div class="t-strong ell" data-f="name">${r[2]}</div><div class="cell-sub ell">${r[3]}</div></td><td>${GL.ui.tag(r[1], r[4], false)}</td><td><span class="row gap-2">${tmAv(r[5], 'sm')}<span class="t-sm">${tmName(r[5]).split(' ')[0]}</span></span></td><td class="sec">${r[6]}</td><td data-st>${r[7] ? GL.ui.tag('success', L('اتقفل', 'Closed')) : GL.ui.tag('warning', L('مفتوح', 'Open'))}</td><td class="right">${GL.ui.menuBtn('risk')}</td></tr>`;
const fileRow = (L, f) => `<tr data-row data-cat="${f[4]}"><td><div class="row gap-3"><span class="ftype ${f[0]}">${f[0].toUpperCase()}</span><div style="min-width:0"><div class="t-strong ltr ell" style="text-align:start" data-f="name">${f[1]}</div><div class="cell-sub">${f[2]}</div></div></div></td><td class="sec">${L(...{ contract: ['العقد والعروض', 'Contract & SOW'], design: ['التصميم', 'Design'], data: ['البيانات', 'Data'], uat: ['UAT', 'UAT'], train: ['التدريب', 'Training'] }[f[4]])}</td><td><span class="row gap-2">${f[3] === 'c' ? tmAv('ma', 'sm') : GL.ui.av(L('ه', 'HS'), 'av-blue sm', 'round')}<span class="t-sm">${f[3] === 'c' ? L('منى عادل', 'Mona Adel') : L('هبة سليم', 'Heba Selim')}</span></span></td><td class="sec">${f[5]}</td><td data-vis>${f[6] ? GL.ui.tag('brand', L('ظاهر للعميل', 'Shared with client'), false) : GL.ui.tag('neutral', L('داخلي', 'Internal'), false)}</td><td class="right">${GL.ui.menuBtn('file')}</td></tr>`;

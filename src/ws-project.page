.hero{padding:var(--gl-space-6) var(--gl-space-6) 0}
.hero-top{display:flex;align-items:flex-start;gap:var(--gl-space-5)}
.meta{display:flex;flex-wrap:wrap;gap:var(--gl-space-2) var(--gl-space-6);margin-top:var(--gl-space-3);font:var(--gl-type-body-sm);color:var(--gl-text-secondary)}
.meta span{display:inline-flex;align-items:center;gap:6px}
.meta svg.i{width:16px;height:16px;color:var(--gl-text-muted)}
.hero .tabs{margin-top:var(--gl-space-6);border-block-end:0;margin-inline:calc(var(--gl-space-6) * -1);padding-inline:var(--gl-space-6);border-block-start:1px solid var(--gl-border-default)}
.hero .tab{height:48px}
/* gantt */
.gantt{display:grid;grid-template-columns:184px minmax(0,1fr);font:var(--gl-type-body-sm)}
.g-months{display:grid;grid-template-columns:repeat(6,1fr);border-block-end:1px solid var(--gl-border-default)}
.g-months span{padding:0 var(--gl-space-2) var(--gl-space-2);font:var(--gl-type-label-sm);color:var(--gl-text-muted);border-inline-start:1px solid var(--gl-border-default)}
.g-lab{display:flex;align-items:center;gap:var(--gl-space-2);height:44px;padding-inline-end:var(--gl-space-3);min-width:0}
.g-lab .n{font:var(--gl-type-label);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.g-lab svg.i{width:16px;height:16px}
.g-track{position:relative;height:44px;background-image:linear-gradient(to right,var(--gl-chart-grid) 1px,transparent 1px);background-size:calc(100% / 6) 100%}
[dir="rtl"] .g-track{background-image:linear-gradient(to left,var(--gl-chart-grid) 1px,transparent 1px)}
.g-bar{position:absolute;top:12px;height:20px;border-radius:6px;display:flex;align-items:center;padding-inline:var(--gl-space-2);font:var(--gl-type-label-sm);color:#fff;white-space:nowrap;overflow:hidden}
.g-bar.done{background:var(--gl-brand-primary)}
[data-theme="dark"] .g-bar.done{color:var(--gl-brand-950)}
.g-bar.cur{background:var(--gl-bg-subtle);color:var(--gl-text-primary);border:1px solid var(--gl-border-strong);overflow:hidden}
.g-bar.cur > i{position:absolute;inset-block:0;inset-inline-start:0;background:color-mix(in srgb,var(--gl-accent-default) 55%,transparent)}
.g-bar.cur > span{position:relative}
.g-bar.next{background:transparent;border:1.5px dashed var(--gl-border-strong);color:var(--gl-text-muted)}
.g-ms{position:absolute;top:15px;width:14px;height:14px;transform:translateX(calc(-50% * var(--gl-flip))) rotate(45deg);background:var(--gl-accent-default);border:2px solid var(--gl-bg-surface);box-shadow:0 0 0 1px var(--gl-accent-600)}
.g-today{position:absolute;inset-block:0;width:2px;background:var(--gl-danger-solid);z-index:2}
.g-today b{position:absolute;top:-22px;inset-inline-start:-18px;font:var(--gl-type-label-sm);color:var(--gl-danger-fg);white-space:nowrap}
.g-body{position:relative}
/* requirements */
.req-sum{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--gl-space-3);margin-bottom:var(--gl-space-4)}
.req-sum div{padding:var(--gl-space-3);border-radius:var(--gl-radius-md);background:var(--gl-bg-subtle)}
.req-sum b{display:block;font:600 20px/28px var(--gl-font-sans)}
.req-sum span{font:var(--gl-type-caption);color:var(--gl-text-secondary)}
.stackbar{display:flex;height:8px;border-radius:999px;overflow:hidden;gap:2px;margin-bottom:var(--gl-space-5)}
.rq td{height:56px}
.rid{font:500 12px/18px ui-monospace,Menlo,Consolas,monospace;color:var(--gl-text-muted);direction:ltr}
/* kanban */
.kb{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--gl-space-4)}
.kcol{background:var(--gl-bg-subtle);border-radius:var(--gl-radius-md);padding:var(--gl-space-3);display:flex;flex-direction:column;gap:var(--gl-space-2)}
.kcol h4{font:var(--gl-type-label);display:flex;align-items:center;gap:var(--gl-space-2);padding:var(--gl-space-1) var(--gl-space-1) var(--gl-space-2)}
.kcol h4 .n{font:var(--gl-type-label-sm);color:var(--gl-text-muted)}
.kc{background:var(--gl-bg-surface);border:1px solid var(--gl-border-default);border-radius:var(--gl-radius-md);padding:var(--gl-space-3);box-shadow:var(--gl-shadow-xs);display:flex;flex-direction:column;gap:var(--gl-space-2)}
.kc .t{font:var(--gl-type-label)}
.kc .f{display:flex;align-items:center;justify-content:space-between;font:var(--gl-type-caption);color:var(--gl-text-muted)}
.kc .f .avatar{width:22px;height:22px;font-size:10px}
/* readiness */
.ready{display:flex;align-items:center;gap:var(--gl-space-5)}
.ring{position:relative;width:112px;height:112px;flex:none}
.ring .c{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.ring .c b{font:600 26px/30px var(--gl-font-sans);display:block}
.ring .c span{font:var(--gl-type-caption);color:var(--gl-text-muted)}
.rd{display:flex;flex-direction:column;gap:var(--gl-space-2);flex:1;min-width:0}
.rd div{display:flex;align-items:center;gap:var(--gl-space-2);font:var(--gl-type-body-sm)}
.rd svg.i{width:16px;height:16px}
.risk{display:flex;gap:var(--gl-space-3);padding:var(--gl-space-4) var(--gl-space-6)}
.risk + .risk{border-block-start:1px solid var(--gl-border-default)}
.risk .t{font:var(--gl-type-body-strong)}
.risk .d{font:var(--gl-type-body-sm);color:var(--gl-text-secondary);margin-top:2px}
.risk .m{display:flex;align-items:center;gap:var(--gl-space-2);margin-top:var(--gl-space-2);flex-wrap:wrap}
.sev{width:4px;border-radius:4px;flex:none}
.ct{display:flex;align-items:center;gap:var(--gl-space-3);padding-block:var(--gl-space-3)}
.ct + .ct{border-block-start:1px solid var(--gl-border-default)}
.ct .t{font:var(--gl-type-label)}
.ct .r{font:var(--gl-type-caption);color:var(--gl-text-muted)}
.ct .row{margin-inline-start:auto}

.apc{display:flex;align-items:center;gap:var(--gl-space-3);padding:var(--gl-space-3) var(--gl-space-4);border:1px solid var(--gl-border-default);border-radius:var(--gl-radius-md)}
.kb.k4{grid-template-columns:repeat(4,minmax(0,1fr))}
.kc.add{border-style:dashed;background:transparent;box-shadow:none;color:var(--gl-text-muted);flex-direction:row;align-items:center;justify-content:center;gap:var(--gl-space-2);font:var(--gl-type-label-sm);cursor:pointer;min-height:40px;width:100%}
.kc .icon-btn.sm{width:24px;height:24px}
.sev-dot{display:block;width:10px;height:10px;border-radius:50%}
.toolbar .sel{width:184px}.toolbar .sel .control{width:100%}
//JS
const WT = () => GL_TEAM;

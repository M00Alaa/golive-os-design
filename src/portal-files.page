          <td>${f[9] ? ui.tag(f[9], f[10]) : '<span class="muted">—</span>'}</td><td class="right"><button class="icon-btn sm">${icon('download')}</button></td></tr>`).join('')}</tbody>
      </table>
    </section>
    <div class="dropzone"><span class="ic-tile">${icon('cloud-upload')}</span><div class="t-strong">${L('اسحب ملفات هنا عشان تشاركها مع الفريق', 'Drop files here to share them with the team')}</div><div class="t-cap muted">${L('حتى 500 MB للملف · ملفاتك بتتحفظ مشفرة', 'Up to 500 MB per file · encrypted at rest')}</div></div>`;
  }
});

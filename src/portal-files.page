.fold{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--gl-space-4)}
.fo{display:flex;align-items:center;gap:var(--gl-space-3);padding:var(--gl-space-4)}
.fo .t{font:var(--gl-type-body-strong)}
.fo .m{font:var(--gl-type-caption);color:var(--gl-text-muted)}
.fn{font:var(--gl-type-body-strong);direction:ltr;unicode-bidi:isolate;overflow:hidden;text-overflow:ellipsis;display:block}
[dir="rtl"] .fn{text-align:right}
//JS
GL.mount({
  shell: 'portal', nav: 'p-files',
  title: L => L('الملفات', 'Files'),
  render: (L, { icon, ui }) => {
    const F = [
      ['pdf', 'PDF', 'UAT_Scenarios_v3.pdf', L('منى عادل', 'Mona Adel'), 'av-teal', L('م', 'MA'), L('اختبار القبول', 'UAT'), '1.2 MB', L('22 نوف', 'Nov 22'), 'warning', L('محتاج توقيع', 'Needs sign-off')],
      ['xls', 'XLS', 'Opening_Stock_Nov.xlsx', L('هبة سليم', 'Heba Selim'), 'av-blue', L('ه', 'HS'), L('ترحيل البيانات', 'Data migration'), '840 KB', L('اليوم', 'Today'), 'success', L('اتراجع', 'Reviewed')],
      ['xls', 'XLS', 'Customer_Balances_TEMPLATE.xlsx', L('حسام علي', 'Hossam Ali'), 'av-blue', L('ح', 'HA'), L('ترحيل البيانات', 'Data migration'), '96 KB', L('20 نوف', 'Nov 20'), 'info', L('قالب', 'Template')],
      ['doc', 'DOC', 'Blueprint_v2_signed.docx', L('منى عادل', 'Mona Adel'), 'av-teal', L('م', 'MA'), L('التصميم', 'Design'), '2.4 MB', L('4 أكت', 'Oct 4'), 'success', L('معتمد', 'Signed')],
      ['img', 'PNG', 'Warehouse_Layout_A.png', L('طارق فوزي', 'Tarek Fawzy'), 'av-violet', L('ط', 'TF'), L('الاكتشاف', 'Discovery'), '3.1 MB', L('14 سبت', 'Sep 14')],
      ['zip', 'ZIP', 'Legacy_ERP_Export_2023-2026.zip', L('طارق فوزي', 'Tarek Fawzy'), 'av-violet', L('ط', 'TF'), L('ترحيل البيانات', 'Data migration'), '148 MB', L('10 أكت', 'Oct 10')],
      ['pdf', 'PDF', 'Project_Plan_Signed.pdf', L('منى عادل', 'Mona Adel'), 'av-teal', L('م', 'MA'), L('الاكتشاف', 'Discovery'), '640 KB', L('2 سبت', 'Sep 2'), 'success', L('معتمد', 'Signed')]
    ];
    return `
    <div class="page-head">
      <div><h1 class="t-h1">${L('ملفات المشروع', 'Project files')}</h1><p class="sub">${L('كل الملفات اللي بينك وبين فريق التنفيذ في مكان واحد', 'Everything shared between you and the implementation team')}</p></div>
      <div class="actions"><button class="btn btn-primary">${icon('upload', 'sm')}${L('رفع ملف', 'Upload')}</button></div>
    </div>
    <section class="fold">${[['folder', L('مستندات معتمدة', 'Signed documents'), L('6 ملفات', '6 files'), 'success'], ['database', L('ترحيل البيانات', 'Data migration'), L('14 ملف · 212 MB', '14 files · 212 MB'), 'warning'], ['clipboard-list', L('اختبار القبول', 'UAT'), L('5 ملفات', '5 files'), 'info'], ['users', L('التدريب', 'Training'), L('قريبًا', 'Coming soon'), 'violet']].map(f => `<div class="card fo"><span class="ic-tile" style="${ui.tone[f[3]]}">${icon(f[0])}</span><div><div class="t">${f[1]}</div><div class="m">${f[2]}</div></div></div>`).join('')}</section>
    <section class="card table-wrap">
      <div class="toolbar"><label class="control search">${icon('search', 'sm')}<input placeholder="${L('ابحث في الملفات…', 'Search files…')}"></label><span class="chip">${icon('plus')}${L('المرحلة', 'Phase')}</span><span class="chip">${icon('plus')}${L('النوع', 'Type')}</span>
        <div class="end"><span class="t-cap muted">${L('مستخدم 412 MB من 10 GB', '412 MB of 10 GB used')}</span></div></div>
      <table class="tbl">
        <colgroup><col><col style="width:184px"><col style="width:152px"><col style="width:96px"><col style="width:104px"><col style="width:152px"><col style="width:72px"></colgroup>
        <thead><tr><th>${L('الملف', 'File')}</th><th>${L('شاركه', 'Shared by')}</th><th>${L('المرحلة', 'Phase')}</th><th>${L('الحجم', 'Size')}</th><th>${L('التاريخ', 'Date')}</th><th>${L('الحالة', 'Status')}</th><th></th></tr></thead>
        <tbody>${F.map(f => `<tr><td><div class="cell-co"><span class="ftype ${f[0]}">${f[1]}</span><div style="min-width:0"><span class="fn">${f[2]}</span></div></div></td>

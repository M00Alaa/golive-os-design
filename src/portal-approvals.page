          <div class="ln" style="width:88%"></div><div class="ln" style="width:70%"></div>
        </div></div>
        <div class="grid g-2" style="gap:0">
          <div class="signbox" style="border-inline-end:1px solid var(--gl-border-default)">
            <div class="t-strong">${L('تعليقات', 'Comments')} <span class="badge soft">2</span></div>

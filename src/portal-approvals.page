      [L('تعديل نطاق: تكامل الميزان', 'Change request: weighbridge integration'), 'CR-04', L('+18 ساعة · +$1,440', '+18 hours · +$1,440'), 'warning', L('مستني توقيعك', 'Awaiting you')],
      [L('وثيقة التصميم (Blueprint)', 'Solution blueprint'), 'v2', L('وقّعتها 4 أكتوبر', 'You signed Oct 4'), 'success', L('معتمدة', 'Signed')],

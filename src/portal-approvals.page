            <div class="msg">${ui.av(L('م', 'MA'), 'av-teal', 'round')}<div class="grow"><div class="t-cap muted"><b style="color:var(--gl-text-primary)">${L('منى عادل', 'Mona Adel')}</b> · v3 · 22 ${L('نوف', 'Nov')}</div><div class="t-sm">${L('اتضاف S-07 ✔', 'Added as S-07 ✔')}</div></div></div>
            <span class="control">${icon('message', 'sm')}<input placeholder="${L('اكتب تعليق…', 'Add a comment…')}"></span>
          </div>
          <div class="signbox">
            <div class="t-strong">${L('التوقيع', 'Sign-off')}</div>

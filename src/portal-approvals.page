.al{display:flex;flex-direction:column}
.ai{display:flex;gap:var(--gl-space-3);padding:var(--gl-space-4) var(--gl-space-5);border-inline-start:3px solid transparent}
.ai + .ai{border-block-start:1px solid var(--gl-border-default)}
.ai.on{background:var(--gl-brand-subtle);border-inline-start-color:var(--gl-brand-primary)}
.ai .t{font:var(--gl-type-body-strong)}
.ai .m{font:var(--gl-type-caption);color:var(--gl-text-muted);margin-top:4px;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.doc-v{background:var(--gl-bg-subtle);padding:var(--gl-space-6);display:flex;justify-content:center;border-block:1px solid var(--gl-border-default)}
.paper{width:100%;max-width:620px;background:var(--gl-bg-surface);border-radius:var(--gl-radius-sm);box-shadow:var(--gl-shadow-md);padding:var(--gl-space-8);display:flex;flex-direction:column;gap:var(--gl-space-4);font:var(--gl-type-body-sm)}
.paper h3{font:var(--gl-type-h2)}
.paper .ln{height:8px;border-radius:4px;background:var(--gl-bg-subtle)}
.paper table{width:100%;border-collapse:collapse;font:var(--gl-type-caption)}
.paper th,.paper td{border:1px solid var(--gl-border-default);padding:6px 8px;text-align:start}
.paper th{background:var(--gl-bg-subtle);font-weight:600}
.cmt{position:relative;background:var(--gl-accent-subtle);outline:2px solid color-mix(in srgb,var(--gl-accent-default) 50%,transparent);border-radius:4px}
.signbox{padding:var(--gl-space-6);display:flex;flex-direction:column;gap:var(--gl-space-4)}
.sig{font:italic 500 22px/32px "Readex Pro",cursive;color:var(--gl-brand-text);padding:var(--gl-space-2) var(--gl-space-4);border-block-end:1.5px dashed var(--gl-border-strong)}
.vtag{font:500 12px/18px ui-monospace,Menlo,Consolas,monospace;color:var(--gl-text-muted);direction:ltr}
//JS
GL.mount({
  shell: 'portal', nav: 'p-appr',

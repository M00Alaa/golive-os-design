            <div class="row gap-2"><button class="btn btn-outline grow">${icon('pencil', 'sm')}${L('طلب تعديل', 'Request changes')}</button><button class="btn btn-primary grow">${icon('file-pen-line', 'sm')}${L('اعتماد وتوقيع', 'Approve & sign')}</button></div>
          </div>
        </div>
      </div>
    </section>`;
  }
});

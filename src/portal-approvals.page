          <div class="row gap-2"><button class="icon-btn sm outline">${icon('download')}</button><button class="icon-btn sm outline">${icon('external-link')}</button></div></div>
        <div class="doc-v"><div class="paper">
          <div class="row between"><span class="avatar ws-logo sm">${L('ن', 'NS')}</span><span class="t-cap muted ltr">UAT-AN-2026 · v3</span></div>
          <h3>${L('سيناريوهات اختبار القبول — المبيعات والمشتريات', 'Acceptance test scenarios — Sales & Purchasing')}</h3>
          <div class="ln" style="width:92%"></div><div class="ln" style="width:84%"></div><div class="ln" style="width:60%"></div>
          <table><thead><tr><th>#</th><th>${L('السيناريو', 'Scenario')}</th><th>${L('النتيجة المتوقعة', 'Expected result')}</th><th>${L('القسم', 'Dept')}</th></tr></thead>
            <tbody><tr><td>S-01</td><td>${L('أمر بيع بخصم 10%', 'Sales order with 10% discount')}</td><td>${L('فاتورة بالخصم والضريبة', 'Invoice with discount & VAT')}</td><td>${L('المبيعات', 'Sales')}</td></tr>
              <tr><td>S-02</td><td>${L('بيع بالأجل لعميل فوق الحد', 'Credit sale over customer limit')}</td><td>${L('يتوقف لحين الاعتماد', 'Blocked pending approval')}</td><td>${L('المبيعات', 'Sales')}</td></tr>
              <tr class="cmt"><td>S-07</td><td>${L('مرتجع مبيعات جزئي', 'Partial sales return')}</td><td>${L('إشعار دائن وتحديث المخزون', 'Credit note + stock update')}</td><td>${L('المخازن', 'Inventory')}</td></tr>
